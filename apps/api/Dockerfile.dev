# Keep in step with required-version in pyproject.toml; bump tag and digest together.
FROM ghcr.io/astral-sh/uv:0.13.5@sha256:32a7bb39b496babbd997b0a39a4d66c126bdaf5661b302bf6f06abda8deca6ff AS uv

FROM python:3.15.1-alpine3.24@sha256:54448f67d7c31c39e5cdd3ea2d6382395ce142806c284425f8e897d78a0465b3 AS backend

# set environment variables
ENV PYTHONDONTWRITEBYTECODE 1
ENV PYTHONUNBUFFERED 1
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 
ENV INSTANCE_CHANGELOG_URL https://sites.plane.so/pages/691ef037bcfe416a902e48cb55f59891/
# Install into the image's Python (/usr/local), not /code/.venv: the compose
# files bind-mount the source over /code, which would hide an in-tree venv.
ENV UV_PROJECT_ENVIRONMENT=/usr/local
ENV UV_PYTHON_DOWNLOADS=never
ENV UV_COMPILE_BYTECODE=1
ENV UV_NO_CACHE=1

RUN apk --no-cache add \
    "bash~=5.3" \
    "libpq" \
    "libxslt" \
    "nodejs-current" \
    "xmlsec" \
    "libffi-dev" \
    "g++" \
    "gcc" \
    "cargo" \
    "git" \
    "make" \
    "postgresql-dev" \
    "libc-dev" \
    "linux-headers"

WORKDIR /code

COPY --from=uv /uv /usr/local/bin/uv
COPY pyproject.toml uv.lock ./

# Install the default groups (dev + test). --inexact keeps the base image's pip.
RUN uv sync --locked --inexact


COPY . .

RUN mkdir -p /code/plane/logs
RUN chmod -R +x /code/bin
RUN chmod -R 777 /code


# Expose container port and run entry point script
EXPOSE 8000

CMD [ "./bin/docker-entrypoint-api-local.sh" ]

