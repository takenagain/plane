# Keep in step with required-version in pyproject.toml; bump tag and digest together.
FROM ghcr.io/astral-sh/uv:0.13.7@sha256:96f40d3904aad8d0bd010539001d36c8e2188b981e1334471a90c4a1d93bb490 AS uv

FROM python:3.15.2-alpine3.24@sha256:a0f2e268f2ce8f3709611a90054ec6a8ae31f6251f5896b8648b9bb99835e30a

# set environment variables
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 
ENV INSTANCE_CHANGELOG_URL=https://sites.plane.so/pages/691ef037bcfe416a902e48cb55f59891/
# uv installs the locked dependencies straight into the image's Python
# (/usr/local), so python, gunicorn and celery resolve exactly as with pip.
ENV UV_PROJECT_ENVIRONMENT=/usr/local
ENV UV_PYTHON_DOWNLOADS=never
ENV UV_COMPILE_BYTECODE=1
ENV UV_NO_CACHE=1
# grpcio ships its own roots.pem, which still trusts emSign ECC Root CA - G3 (eMudhra incident);
# point it at the system bundle, which the OS update below keeps current.
ENV GRPC_DEFAULT_SSL_ROOTS_FILE_PATH=/etc/ssl/certs/ca-certificates.crt

# OS security updates. --available forces reinstall from the current repos;
# bump APK_SECURITY_PATCH to bust buildx's cached layer (keyed on this command
# string), otherwise a rebuild silently re-ships the old packages.
ARG APK_SECURITY_PATCH=2026-11-09
RUN echo "apk-security-patch ${APK_SECURITY_PATCH}" && apk update && apk upgrade --available

WORKDIR /code

RUN apk add --no-cache --upgrade \
    "libpq" \
    "libxslt" \
    "xmlsec" \
    "ca-certificates" \
    "openssl"

COPY pyproject.toml uv.lock ./
RUN apk add --no-cache libffi-dev
# uv is bind-mounted for this step only, so the binary never ships in the image.
# --inexact keeps the base image's own packages (pip) in place.
RUN --mount=from=uv,source=/uv,target=/bin/uv \
    apk add --no-cache --virtual .build-deps \
    "bash~=5.3" \
    "g++" \
    "gcc" \
    "cargo" \
    "git" \
    "make" \
    "postgresql-dev" \
    "libc-dev" \
    "linux-headers" \
    && \
    uv sync --locked --inexact --no-default-groups --group production \
    && \
    apk del .build-deps \
    && \
    rm -rf /var/cache/apk/*

# pip is build tooling only; uv installed everything above and nothing installs
# at runtime. The base image's pip (25.0.1) vendors a certifi that still trusts
# the compromised emSign G3 root (GHSA-6q48-6c7w-9gw2). `python -m ensurepip`
# restores it if ever needed.
RUN rm -rf /usr/local/lib/python3.15/site-packages/pip \
           /usr/local/lib/python3.15/site-packages/pip-*.dist-info \
           /usr/local/bin/pip /usr/local/bin/pip3 /usr/local/bin/pip3.15


# Add in Django deps and generate Django's static files
COPY manage.py manage.py
COPY plane plane/
COPY templates templates/
COPY package.json package.json

RUN apk --no-cache add "bash~=5.3"
COPY ./bin ./bin/

RUN mkdir -p /code/plane/logs
RUN chmod +x ./bin/*
RUN chmod -R 777 /code

# Expose container port and run entry point script
EXPOSE 8000

CMD ["./bin/docker-entrypoint-api.sh"]