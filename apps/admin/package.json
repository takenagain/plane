  "license": "AGPL-3.0",
  "type": "module",
  "scripts": {
    "dev": "react-router dev --port 3001",
    "build": "react-router build",
    "preview": "react-router build && serve -s build/client -l 3001",
    "start": "serve -s build/client -l 3001",
    "clean": "rm -rf .turbo && rm -rf .next && rm -rf node_modules && rm -rf dist && rm -rf build",
    "check:lint": "oxlint -c ../../.oxlintrc.json --max-warnings=759 .",
    "check:types": "react-router typegen && tsc --noEmit",
    "check:format": "oxfmt --check -c ../../.oxfmtrc.json .",
    "fix:lint": "oxlint -c ../../.oxlintrc.json --fix .",
    "fix:format": "oxfmt -c ../../.oxfmtrc.json ."
  },
