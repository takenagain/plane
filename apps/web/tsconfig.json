{
  "compilerOptions": {
    "rootDirs": [".", "./.react-router/types"],
    "paths": {
      "@/*": ["./*"],
      "@/components/*": ["./components/*", "./core/components/*"],
      "@/constants/*": ["./constants/*", "./core/constants/*"],
      "@/hooks/*": ["./hooks/*", "./core/hooks/*"],
      "@/plane-web/*": ["./extended/*"],
      "@/store/*": ["./store/*", "./core/store/*"],
      "package.json": ["./package.json"]
    },
    "strictNullChecks": true,
    "exactOptionalPropertyTypes": false,
    "noUnusedParameters": false,
    "noUnusedLocals": false,
    "noImplicitReturns": false,
    "noImplicitOverride": false,
    "types": ["vite/client", "vitest/globals", "@testing-library/jest-dom/vitest"]
  },
  "extends": "@plane/typescript-config/react-router.json",
  "include": [
    "**/*",
    "**/.server/**/*",
    "**/.client/**/*",
    ".react-router/types/**/*",
    "../../packages/utils/vite/**/*"
  ]
}
