{
  "name": "live",
  "version": "1.3.1",
  "private": true,
  "description": "A realtime collaborative server powers Plane's rich text editor",
  "license": "AGPL-3.0",
  "author": "Plane Software Inc.",
  "type": "module",
  "exports": {
    ".": "./dist/start.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc --noEmit && tsdown",
    "dev": "tsdown --watch --no-clean --onSuccess \"node --env-file=.env .\"",
    "start": "node --env-file=.env .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:lint": "oxlint -c ../../.oxlintrc.json --max-warnings=119 .",
    "check:types": "tsc --noEmit",
    "check:format": "oxfmt --check -c ../../.oxfmtrc.json .",
    "fix:lint": "oxlint -c ../../.oxlintrc.json --fix .",
    "fix:format": "oxfmt -c ../../.oxfmtrc.json .",
    "clean": "rm -rf .turbo && rm -rf .next && rm -rf node_modules && rm -rf dist"
  },
  "dependencies": {
    "@effect/platform": "^0.94.5",
    "@effect/platform-node": "^0.104.1",
    "@fontsource/inter": "5.2.8",
    "@hocuspocus/extension-database": "3.4.4",
    "@hocuspocus/extension-logger": "3.4.4",
    "@hocuspocus/extension-redis": "3.4.4",
    "@hocuspocus/server": "3.4.4",
    "@hocuspocus/transformer": "3.4.4",
    "@plane/decorators": "workspace:*",
    "@plane/editor": "workspace:*",
    "@plane/logger": "workspace:*",
    "@plane/types": "workspace:*",
    "@react-pdf/renderer": "^4.5.1",
    "@react-pdf/types": "^2.11.1",
    "@tiptap/core": "^3.22.3",
    "@tiptap/html": "^3.22.3",
    "@tiptap/pm": "^3.22.3",
    "axios": "catalog:",
    "compression": "1.8.1",
    "cors": "^2.8.6",
    "dotenv": "catalog:",
    "effect": "3.21.2",
    "express": "catalog:",
    "express-ws": "^5.0.2",
    "helmet": "^8.1.0",
    "ioredis": "5.10.1",
    "react": "catalog:",
    "sharp": "^0.34.5",
    "uuid": "catalog:",
    "ws": "^8.19.0",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.30",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@plane/typescript-config": "workspace:*",
    "@types/compression": "1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "4.17.23",
    "@types/express-ws": "^3.0.6",
    "@types/node": "catalog:",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "catalog:",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.0.18",
    "pdf-parse": "^2.4.5",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "^4.0.18"
  }
}
