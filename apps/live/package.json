{
  "name": "live",
  "version": "1.4.2",
  "private": true,
  "description": "A realtime collaborative server powers Plane's rich text editor",
  "license": "AGPL-3.0",
  "author": "Plane Software Inc.",
  "type": "module",
  "exports": {
    ".": "./dist/start.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc --noEmit && tsdown",
    "dev": "tsdown --watch --no-clean --onSuccess \"node --env-file=.env .\"",
    "start": "node --env-file=.env .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:lint": "oxlint -c ../../.oxlintrc.json --max-warnings=119 .",
    "check:types": "tsc --noEmit",
    "check:format": "oxfmt --check -c ../../.oxfmtrc.json .",
    "fix:lint": "oxlint -c ../../.oxlintrc.json --fix .",
    "fix:format": "oxfmt -c ../../.oxfmtrc.json .",
    "clean": "rm -rf .turbo && rm -rf .next && rm -rf node_modules && rm -rf dist"
  },
  "dependencies": {
    "@effect/platform": "catalog:",
    "@effect/platform-node": "catalog:",
    "@fontsource/inter": "catalog:",
    "@hocuspocus/extension-database": "catalog:",
    "@hocuspocus/extension-logger": "catalog:",
    "@hocuspocus/extension-redis": "catalog:",
    "@hocuspocus/server": "catalog:",
    "@hocuspocus/transformer": "catalog:",
    "@plane/decorators": "workspace:*",
    "@plane/editor": "workspace:*",
    "@plane/logger": "workspace:*",
    "@plane/services": "workspace:*",
    "@plane/types": "workspace:*",
    "@plane/utils": "workspace:*",
    "@react-pdf/renderer": "catalog:",
    "@react-pdf/types": "catalog:",
    "@tiptap/core": "catalog:",
    "@tiptap/html": "catalog:",
    "@tiptap/pm": "catalog:",
    "axios": "catalog:",
    "compression": "catalog:",
    "cors": "catalog:",
    "dotenv": "catalog:",
    "effect": "catalog:",
    "express": "catalog:",
    "express-ws": "catalog:",
    "helmet": "catalog:",
    "ioredis": "catalog:",
    "react": "catalog:",
    "sharp": "0.35.3",
    "uuid": "14.0.1",
    "ws": "8.21.0",
    "y-prosemirror": "1.3.7",
    "y-protocols": "1.0.7",
    "yjs": "13.6.31",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@plane/typescript-config": "workspace:^1.3.1",
    "@types/compression": "1.8.1",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/express-ws": "3.0.6",
    "@types/node": "26.1.0",
    "@types/pdf-parse": "1.1.5",
    "@types/react": "catalog:",
    "@types/ws": "8.18.1",
    "@vitest/coverage-v8": "4.1.9",
    "pdf-parse": "2.4.5",
    "tsdown": "0.22.3",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  }
}
