FROM node:26.13.0-alpine3.24@sha256:8996bb5821d62a8fd9bb27c1cb07462f3fdce6e47d640c6a881ead0b064ce216

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PNPM_HOME/bin:$PATH"
ARG PNPM_VERSION=12.15.0
ARG TURBO_VERSION=2.11.10

RUN apk add --no-cache libc6-compat
WORKDIR /app

COPY . .
RUN mkdir -p "$PNPM_HOME" && npm install --global --allow-scripts=pnpm pnpm@${PNPM_VERSION} && pnpm add --global turbo@${TURBO_VERSION}
RUN pnpm install
EXPOSE 3003

ENV TURBO_TELEMETRY_DISABLED=1

VOLUME [ "/app/node_modules", "/app/live/node_modules"]

CMD ["pnpm","dev", "--filter=live"]
