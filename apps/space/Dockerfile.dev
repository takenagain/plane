FROM node:26.12.1-alpine3.24@sha256:40cd011b55415bc894e45b02fdd5a5dfde056921b7d23a64c74f80497af48797

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PNPM_HOME/bin:$PATH"
ARG PNPM_VERSION=12.15.0
ARG TURBO_VERSION=2.11.10

RUN apk add --no-cache libc6-compat

# Set working directory
WORKDIR /app

COPY . .

RUN mkdir -p "$PNPM_HOME" && npm install --global --allow-scripts=pnpm pnpm@${PNPM_VERSION} && pnpm add --global turbo@${TURBO_VERSION}
RUN pnpm install

EXPOSE 3002

ENV VITE_SPACE_BASE_PATH="/spaces"

VOLUME [ "/app/node_modules", "/app/apps/space/node_modules"]

CMD ["pnpm", "dev", "--filter=space"]
