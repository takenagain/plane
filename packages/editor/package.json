{
  "name": "@plane/editor",
  "version": "1.3.1",
  "private": true,
  "description": "Core Editor that powers Plane",
  "keywords": [
    "editor",
    "markdown",
    "nextjs",
    "react",
    "rich-text"
  ],
  "license": "AGPL-3.0",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./lib": "./dist/lib.js",
    "./package.json": "./package.json",
    "./styles.css": "./dist/styles/index.css",
    "./styles": "./dist/styles/index.css"
  },
  "scripts": {
    "build": "tsc && tsdown",
    "dev": "tsdown --watch --no-clean",
    "check:lint": "oxlint --max-warnings=416 .",
    "check:types": "tsc --noEmit",
    "check:format": "oxfmt --check .",
    "fix:lint": "oxlint --fix .",
    "fix:format": "oxfmt .",
    "clean": "rm -rf .turbo && rm -rf .next && rm -rf node_modules && rm -rf dist"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.6",
    "@floating-ui/react": "^0.27.19",
    "@headlessui/react": "^2.2.10",
    "@hocuspocus/provider": "4.1.0",
    "@plane/constants": "workspace:^1.3.1",
    "@plane/hooks": "workspace:^1.3.1",
    "@plane/propel": "workspace:^1.3.1",
    "@plane/types": "workspace:^1.3.1",
    "@plane/ui": "workspace:^1.3.1",
    "@plane/utils": "workspace:^1.3.1",
    "@tiptap/core": "catalog:",
    "@tiptap/extension-blockquote": "^3.23.6",
    "@tiptap/extension-character-count": "^3.23.6",
    "@tiptap/extension-collaboration": "^3.23.6",
    "@tiptap/extension-document": "^3.23.6",
    "@tiptap/extension-emoji": "^3.23.6",
    "@tiptap/extension-heading": "^3.23.6",
    "@tiptap/extension-image": "^3.23.6",
    "@tiptap/extension-list-item": "^3.23.6",
    "@tiptap/extension-mention": "^3.23.6",
    "@tiptap/extension-placeholder": "^3.23.6",
    "@tiptap/extension-task-item": "^3.23.6",
    "@tiptap/extension-task-list": "^3.23.6",
    "@tiptap/extension-text": "^3.23.6",
    "@tiptap/extension-text-align": "^3.23.6",
    "@tiptap/extension-text-style": "^3.23.6",
    "@tiptap/extension-underline": "^3.23.6",
    "@tiptap/html": "catalog:",
    "@tiptap/pm": "^3.23.6",
    "@tiptap/react": "^3.23.6",
    "@tiptap/starter-kit": "^3.23.6",
    "@tiptap/suggestion": "^3.23.6",
    "buffer": "^6.0.3",
    "emoji-regex": "^10.6.0",
    "highlight.js": "^11.11.1",
    "is-emoji-supported": "^0.0.5",
    "jsx-dom-cjs": "^8.1.6",
    "linkifyjs": "^4.3.3",
    "lodash-es": "catalog:",
    "lowlight": "^3.3.0",
    "lucide-react": "catalog:",
    "prosemirror-codemark": "^0.4.2",
    "prosemirror-markdown": "^1.13.4",
    "tippy.js": "^6.3.7",
    "tiptap-markdown": "^0.9.0",
    "uuid": "catalog:",
    "y-indexeddb": "^9.0.12",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.30"
