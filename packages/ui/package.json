{
  "name": "@plane/ui",
  "version": "1.3.1",
  "private": true,
  "description": "UI components shared across multiple apps internally",
  "license": "AGPL-3.0",
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch --no-clean",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "postcss": "postcss styles/globals.css -o styles/output.css --watch",
    "check:lint": "oxlint --max-warnings=66 .",
    "check:types": "tsc --noEmit",
    "check:format": "oxfmt --check .",
    "fix:lint": "oxlint --fix .",
    "fix:format": "oxfmt .",
    "clean": "rm -rf .turbo && rm -rf .next && rm -rf node_modules && rm -rf dist"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "2.0.1",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "2.0.0",
    "@blueprintjs/core": "6.17.0",
    "@floating-ui/react-dom": "2.1.8",
    "@headlessui/react": "2.2.10",
    "@plane/constants": "workspace:^1.3.1",
    "@plane/hooks": "workspace:^1.3.1",
    "@plane/propel": "workspace:^1.3.1",
    "@plane/types": "workspace:^1.3.1",
    "@plane/utils": "workspace:^1.3.1",
    "@radix-ui/react-scroll-area": "1.2.13",
    "@simplewebauthn/browser": "13.3.0",
    "clsx": "2.1.1",
    "lodash-es": "4.18.1",
    "lucide-react": "1.22.0",
    "qrcode.react": "4.2.0",
    "react-color": "2.19.3",
    "react-day-picker": "10.0.1",
    "tailwind-merge": "3.6.0",
    "use-font-face-observer": "1.3.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "5.2.1",
    "@plane/tailwind-config": "workspace:*",
    "@plane/typescript-config": "workspace:*",
    "@storybook/addon-docs": "10.4.6",
    "@storybook/addon-links": "10.4.6",
    "@storybook/addon-onboarding": "10.4.6",
    "@storybook/addon-styling-webpack": "3.0.2",
    "@storybook/addon-webpack5-compiler-swc": "4.0.3",
    "@storybook/react": "10.4.6",
    "@storybook/react-webpack5": "10.4.6",
    "@types/lodash-es": "4.17.12",
    "@types/node": "26.1.0",
    "@types/react": "19.2.17",
    "@types/react-color": "3.0.13",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.5.2",
    "css-loader": "7.1.4",
    "postcss": "8.5.18",
    "postcss-cli": "11.0.1",
    "postcss-loader": "8.2.1",
    "postcss-nested": "7.0.2",
    "storybook": "10.4.6",
    "style-loader": "4.0.0",
    "tsdown": "0.22.3",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  }
}
